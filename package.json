{
    "name": "kkn-frontend",
    "version": "1.0.0",
    "private": true,
    "description": "Aplikasi KKN LPPM UNFARI — situs statis untuk GitHub Pages. Tailwind + DaisyUI dikompilasi ke satu app.css, bukan Play CDN.",
    "scripts": {
        "build": "npm run build:css",
        "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/app.css --minify",
        "watch:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/app.css --watch"
    },
    "devDependencies": {
        "daisyui": "4.12.10",
        "tailwindcss": "3.4.13"
    }
}
